# ==============================================================================
# ThreatLens Environment Configuration Example
# Copy this file to .env and supply your API keys if available.
# ThreatLens gracefully degrades and skips providers whose keys are not set.
# ==============================================================================

# --- Provider API Keys ---
# VirusTotal v3 API Key (free tier: ~4 req/min, 500 req/day)
# https://www.virustotal.com/gui/user/<username>/apikey
THREATLENS_VIRUSTOTAL_API_KEY=

# AlienVault OTX API Key
# https://otx.alienvault.com/api
THREATLENS_OTX_API_KEY=

# AbuseIPDB API Key (v2) (free tier: 1000 req/day)
# https://www.abuseipdb.com/account/api
THREATLENS_ABUSEIPDB_API_KEY=

# --- Service API Authentication ---
# Optional secret key for securing ThreatLens's own REST API endpoints.
# If left empty, API authentication is disabled.
THREATLENS_API_KEY=

# --- Application Settings ---
# Directory for persistent SQLite cache & history
THREATLENS_CACHE_DIR=./data

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
THREATLENS_LOG_LEVEL=INFO

# Host and Port for API server
THREATLENS_HOST=0.0.0.0
THREATLENS_PORT=8000

# Client Rate Limiting (per client IP on ThreatLens API)
THREATLENS_CLIENT_RATE_LIMIT=60

# --- Scoring Weights (Default: VT=0.5, OTX=0.25, AbuseIPDB=0.25) ---
THREATLENS_WEIGHT_VIRUSTOTAL=0.5
THREATLENS_WEIGHT_OTX=0.25
THREATLENS_WEIGHT_ABUSEIPDB=0.25

# --- Cache TTL (seconds) ---
THREATLENS_TTL_MALICIOUS=21600   # 6 hours
THREATLENS_TTL_SUSPICIOUS=21600  # 6 hours
THREATLENS_TTL_CLEAN=86400       # 24 hours
THREATLENS_TTL_LOW_RISK=86400    # 24 hours
THREATLENS_TTL_UNKNOWN=900       # 15 minutes
